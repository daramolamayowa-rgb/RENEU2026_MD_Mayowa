# created by fftool

units real
boundary p p p

atom_style full
bond_style harmonic
angle_style harmonic
dihedral_style opls

special_bonds lj/coul 0.0 0.0 0.5

# remove hybrid if not necessary
pair_style hybrid lj/cut/coul/long 10.0 10.0
pair_modify mix geometric tail yes
read_data data.lmp
# read_restart restart1.lmp

kspace_style pppm 1.0e-5

# remove pair style if not using hybrid
pair_coeff    1    1 lj/cut/coul/long     0.170000     3.250000  # N1 N1
pair_coeff    2    2 lj/cut/coul/long     0.065999     3.500000  # C1N C1N
pair_coeff    3    3 lj/cut/coul/long     0.000000     0.000000  # HN HN
pair_coeff    4    4 lj/cut/coul/long     0.065999     3.500000  # CS CS
pair_coeff    5    5 lj/cut/coul/long     0.030000     2.500000  # H1N H1N
pair_coeff    6    6 lj/cut/coul/long     0.065999     3.500000  # CEN CEN
pair_coeff    7    7 lj/cut/coul/long     0.030000     2.500000  # HC HC
pair_coeff    8    8 lj/cut/coul/long     0.030000     2.500000  # HCN HCN
pair_coeff    9    9 lj/cut/coul/long     0.105000     3.750000  # CO2 CO2
pair_coeff   10   10 lj/cut/coul/long     0.065999     3.500000  # C2C C2C
pair_coeff   11   11 lj/cut/coul/long     0.210000     2.960000  # O2 O2
pair_coeff   12   12 lj/cut/coul/long     0.065999     3.500000  # CT CT

# minimize 1.0e-4 1.0e-6 100 1000
# reset_timestep 0

fix SHAKE all shake 0.0001 20 0 b 2 4

neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes








#fix VAVG all ave/time 10 1000 50000 v_vinst

# ---------------------------------------------------------------------------
# RENEU 2026 simulation protocol (stage1 M2 propylammonium octanoate)
# 1 minimise  2 NVT relaxation  3 NPT equilibration  4 NPT production
# ---------------------------------------------------------------------------
timestep 1.0

variable TK      equal 300.0
variable PBAR    equal 1.0
variable NVTRUN  equal 20000
variable EQRUN   equal 100000
variable PRODRUN equal 200000

variable dens equal density
variable vol  equal vol

thermo 1000
thermo_style custom step temp press vol v_dens pe etotal

# --- 1. energy minimisation ------------------------------------------------
print "RENEU >>> stage 1 of 4: energy minimisation"
minimize 1.0e-4 1.0e-6 10000 100000
reset_timestep 0

# --- 2. NVT relaxation (lets the packed box relax before the barostat) ------
print "RENEU >>> stage 2 of 4: NVT relaxation"
velocity all create ${TK} 12345 mom yes rot yes dist gaussian
fix NVTRELAX all nvt temp ${TK} ${TK} 100
run ${NVTRUN}
unfix NVTRELAX

# --- 3. NPT equilibration (this is where the density finds its own value) ---
# restart files are written every 25000 steps. If the run stops for any
# reason you can pick up from the last one instead of starting over:
#     read_restart rst_a.lmp      (or rst_b.lmp, whichever is newer)
print "RENEU >>> stage 3 of 4: NPT equilibration - watch the density column"
restart 25000 rst_a.lmp rst_b.lmp
fix NPTEQ all npt temp ${TK} ${TK} 100 iso ${PBAR} ${PBAR} 1000
run ${EQRUN}
unfix NPTEQ
write_data data.after_equilibration.lmp

# --- 4. NPT production - this is the trajectory you analyse ----------------
print "RENEU >>> stage 4 of 4: NPT production"
reset_timestep 0
fix NPTPROD all npt temp ${TK} ${TK} 100 iso ${PBAR} ${PBAR} 1000
fix DENSAVG all ave/time 10 100 1000 v_dens v_vol file density.dat

dump TRAJ all custom 500 dump.lammpstrj id mol type element q xu yu zu
dump_modify TRAJ element N C H C H C H H C C O C

run ${PRODRUN}

write_data data.final.lmp
print "RENEU >>> finished. trajectory = dump.lammpstrj, density log = density.dat"
