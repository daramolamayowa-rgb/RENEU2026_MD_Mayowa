#fix VAVG all ave/time 10 1000 50000 v_vinst

# ---------------------------------------------------------------------------
# RENEU 2026 simulation protocol (stage1 M1 butylammonium octanoate)
# 1 minimise  2 NVT relaxation  3 NPT equilibration  4 NPT production
# ---------------------------------------------------------------------------
timestep 1.0

variable TK      equal 300.0
variable PBAR    equal 1.0
variable NVTRUN  equal 20000
variable EQRUN   equal 100000
variable PRODRUN equal 200000

variable dens equal density
variable vol  equal vol

thermo 1000
thermo_style custom step temp press vol v_dens pe etotal

# --- 1. energy minimisation ------------------------------------------------
print "RENEU >>> stage 1 of 4: energy minimisation"
RENEU >>> stage 1 of 4: energy minimisation
minimize 1.0e-4 1.0e-6 10000 100000
